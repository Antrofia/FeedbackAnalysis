@model FeedbackAnalysis.ClientUI.Models.FeedbacksPageViewModel

@{
    ViewData["Title"] = "Отзывы";
}

<div class="container mt-4">
    <h2 class="mb-4">Отзывы</h2>

    @if (TempData["ReplySuccess"] is string replySuccess)
    {
        <div class="alert alert-success">@replySuccess</div>
    }

    @if (TempData["ReplyError"] is string replyError)
    {
        <div class="alert alert-warning">@replyError</div>
    }

    <!-- Вкладки: серверная навигация через ?tab=... -->
    <ul class="nav nav-pills mb-3">
        <li class="nav-item">
            <a class="nav-link @(Model.Tab == "all" ? "active" : "")"
               asp-controller="Home" asp-action="Index" asp-route-tab="all">
                Все
                @if (Model.Tab == "all")
                {
                    <span class="badge bg-light text-dark ms-1">@Model.Total</span>
                }
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.Tab == "priority" ? "active" : "")"
               asp-controller="Home" asp-action="Index" asp-route-tab="priority">
                ⭐ Приоритетные
                @if (Model.Tab == "priority")
                {
                    <span class="badge bg-light text-dark ms-1">@Model.Total</span>
                }
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.Tab == "archive" ? "active" : "")"
               asp-controller="Home" asp-action="Index" asp-route-tab="archive">
                Архив
                @if (Model.Tab == "archive")
                {
                    <span class="badge bg-light text-dark ms-1">@Model.Total</span>
                }
            </a>
        </li>
    </ul>

    <!-- Список отзывов -->
    <div id="reviewsContainer">
        @if (Model.Items.Count > 0)
        {
            foreach (var feedback in Model.Items)
            {
                ViewData["ReadOnly"] = Model.Tab == "archive";
                ViewData["Tab"] = Model.Tab;
                <partial name="_FeedbackCard" model="feedback" />
            }
        }
        else
        {
            <div class="alert alert-info">Пока нет отзывов.</div>
        }
    </div>

    <!-- Пагинация -->
    <div class="d-flex justify-content-between align-items-center mt-3">
        <span>Всего: @Model.Total</span>
        <nav aria-label="Постраничная навигация">
            <ul class="pagination mb-0">
                <li class="page-item @(Model.HasPrev ? "" : "disabled")">
                    <a class="page-link" asp-controller="Home" asp-action="Index"
                       asp-route-tab="@Model.Tab" asp-route-page="@(Model.Page - 1)">← Назад</a>
                </li>
                <li class="page-item disabled">
                    <span class="page-link">@Model.Page из @(Model.TotalPages > 0 ? Model.TotalPages : 1)</span>
                </li>
                <li class="page-item @(Model.HasNext ? "" : "disabled")">
                    <a class="page-link" asp-controller="Home" asp-action="Index"
                       asp-route-tab="@Model.Tab" asp-route-page="@(Model.Page + 1)">Вперёд →</a>
                </li>
            </ul>
        </nav>
    </div>
</div>

<style>
    .review-item {
        transition: all 0.2s;
    }

        .review-item:hover {
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

    .reply-form {
        max-width: 100%;
    }

    /* Отрицательные отзывы - красный фон */
    .rating-negative {
        background-color: #fde8e8 !important;
    }

    /* Нейтральные отзывы - желтый фон */
    .rating-neutral {
        background-color: #fef9e7 !important;
    }

    /* Положительные отзывы - зеленый фон */
    .rating-positive {
        background-color: #e8f8e8 !important;
    }

    .review-item {
        border: 1px solid rgba(0,0,0,.125);
        border-radius: 0.375rem;
    }
</style>
