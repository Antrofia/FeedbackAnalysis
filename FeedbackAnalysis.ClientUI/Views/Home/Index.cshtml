@model FeedbackAnalysis.ClientUI.Models.FeedbacksPageViewModel

@{
    ViewData["Title"] = "Отзывы";

    var emptyTitle = Model.Tab switch
    {
        "priority" => "Приоритетных отзывов нет",
        "archive" => "Архив пуст",
        _ => "Новых отзывов пока нет"
    };

    var emptyHint = Model.Tab switch
    {
        "priority" => "Негативные отзывы появятся здесь — их стоит обрабатывать в первую очередь.",
        "archive" => "Обработанные и заархивированные отзывы будут собираться здесь.",
        _ => "Как только поступят отзывы маркетплейсов, вы увидите их здесь."
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <div>
        <h1 class="page-heading">Отзывы</h1>
        <p class="page-subtitle mb-0">Отзывы маркетплейсов: реакция оператора и архив</p>
    </div>
</div>

@if (TempData["ReplySuccess"] is string replySuccess)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @replySuccess
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть"></button>
    </div>
}

@if (TempData["ReplyError"] is string replyError)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @replyError
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть"></button>
    </div>
}

<!-- Вкладки: серверная навигация через ?tab=..., у каждой вкладки свой счётчик -->
<div class="tab-switcher mb-4" role="navigation" aria-label="Вкладки отзывов">
    <a class="tab-item @(Model.Tab == "all" ? "active" : "")"
       asp-controller="Home" asp-action="Index" asp-route-tab="all">
        Все
        <span class="tab-count">@Model.CountAll</span>
    </a>
    <a class="tab-item @(Model.Tab == "priority" ? "active" : "")"
       asp-controller="Home" asp-action="Index" asp-route-tab="priority">
        ⭐ Приоритетные
        <span class="tab-count count-priority @(Model.CountPriority > 0 ? "has-items" : "")">@Model.CountPriority</span>
    </a>
    <a class="tab-item @(Model.Tab == "archive" ? "active" : "")"
       asp-controller="Home" asp-action="Index" asp-route-tab="archive">
        Архив
        <span class="tab-count">@Model.CountArchive</span>
    </a>
</div>

<!-- Список отзывов -->
<div id="reviewsContainer">
    @if (Model.Items.Count > 0)
    {
        foreach (var feedback in Model.Items)
        {
            ViewData["ReadOnly"] = Model.Tab == "archive";
            ViewData["Tab"] = Model.Tab;
            <partial name="_FeedbackCard" model="feedback" />
        }
    }
    else
    {
        <div class="empty-state">
            <div class="icon" aria-hidden="true">
                <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="22 12 16 12 14 15 10 15 8 12 2 12" />
                    <path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z" />
                </svg>
            </div>
            <h2>@emptyTitle</h2>
            <p>@emptyHint</p>
        </div>
    }
</div>

<!-- Пагинация -->
<partial name="_PaginationBar" model="Model" />
